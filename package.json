    "mobx-restful-table": "^2.7.4",
    "next": "16.3.4",
    "next-ssr-middleware": "^1.1.1",
    "next-with-less": "^3.0.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-editor": "^2.1.4",
    "react-dom": "^19.3.0",
    "react-editor-js": "^2.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "undici": "^8.10.2",
    "web-utility": "^4.7.2",
    "webpack": "^5.110.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.3.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/koa": "^3.0.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "serwist": "^9.5.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-css-order",
      "@softonus/prettier-plugin-duplicate-remover"
    ]
  },
  "lint-staged": {
    "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write",
    "*.{css,js,mjs,ts,tsx}": "eslint --fix"
  },
  "scripts": {
    "prepare": "husky",
    "install": "next typegen",
    "dev": "next dev --webpack",
    "build": "cross-env CI=true  next build --webpack",
    "start": "next start",
    "lint:all": "eslint --fix .",
    "lint:inspect": "eslint --inspect-config",
    "test": "lint-staged  &&  tsc --noEmit",
    "pack-image": "docker build -t idea2app/next-bootstrap-ts:latest .",
    "container": "docker rm -f next-bootstrap-ts  &&  docker run --name next-bootstrap-ts -p 3000:3000 -d idea2app/next-bootstrap-ts:latest"
  }
}
