{
  "name": "@idea2app/next-bootstrap-ts",
  "version": "1.7.2",
  "description": "React project scaffold based on TypeScript, Next.js, Bootstrap & Workbox.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@editorjs/code": "^2.9.4",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/header": "^2.8.9",
    "@editorjs/image": "^2.10.3",
    "@editorjs/link": "^2.6.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/paragraph": "^3.0.0",
    "@editorjs/quote": "^2.7.6",
    "@koa/router": "^15.7.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@sentry/nextjs": "^10.69.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.49.0",
    "editorjs-html": "^4.0.5",
    "idea-react": "^2.2.2",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.1",
    "koajax": "^3.3.0",
    "less": "^4.8.1",
    "less-loader": "^13.0.0",
    "lodash": "^4.18.1",
    "mobx": "^6.16.1",
    "mobx-github": "^0.7.0",
    "mobx-i18n": "^0.7.5",
    "mobx-react": "^9.2.2",
    "mobx-react-helper": "^0.5.1",
    "mobx-restful": "^2.1.4",
    "mobx-restful-table": "^2.6.6",
    "next": "^16.2.12",
    "next-pwa": "~5.6.0",
    "next-ssr-middleware": "^1.1.1",
    "next-with-less": "^3.0.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-editor": "^2.1.3",
    "react-dom": "^19.2.8",
    "react-editor-js": "^2.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "undici": "^8.9.0",
    "web-utility": "^4.7.2",
    "webpack": "^5.109.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.0.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/koa": "^3.0.3",
    "@types/lodash": "^4.17.25",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "resolutions": {
    "next": "$next"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-css-order",
      "@softonus/prettier-plugin-duplicate-remover"
    ]
  },
  "lint-staged": {
    "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write",
    "*.{css,js,mjs,ts,tsx}": "eslint --fix"
  },
  "scripts": {
    "prepare": "husky",
    "install": "next typegen",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint:all": "eslint --fix .",
    "lint:inspect": "eslint --inspect-config",
    "test": "lint-staged  &&  tsc --noEmit",
    "pack-image": "docker build -t idea2app/next-bootstrap-ts:latest .",
    "container": "docker rm -f next-bootstrap-ts  &&  docker run --name next-bootstrap-ts -p 3000:3000 -d idea2app/next-bootstrap-ts:latest"
  }
}
