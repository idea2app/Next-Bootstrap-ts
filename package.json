{
  "name": "@idea2app/next-bootstrap-ts",
  "version": "2.0.0",
  "description": "React project scaffold based on TypeScript, Next.js, Bootstrap & Workbox.",
  "private": true,
  "engines": {
    "node": "^22.22.1 || >=23.2.0"
  },
  "dependencies": {
    "@khmyznikov/pwa-install": "^0.7.0",
    "@koa/router": "^15.7.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.6",
    "@sentry/nextjs": "^11.12.0",
    "@serwist/next": "^9.5.13",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.51.0",
    "idea-react": "^3.0.0-rc.2",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.3.0",
    "koajax": "^3.3.1",
    "less": "^4.9.1",
    "less-loader": "^13.1.0",
    "lit": "^3.3.3",
    "lodash": "^4.18.1",
    "marked": "^18.2.0",
    "mobx": "^7.1.6",
    "mobx-github": "^0.7.1",
    "mobx-i18n": "^0.7.9",
    "mobx-react": "^10.0.3",
    "mobx-react-helper": "^0.5.4",
    "mobx-restful": "^2.1.5",
    "mobx-restful-table": "^3.0.0-rc.2",
    "next": "16.4.6",
    "next-ssr-middleware": "^1.1.5",
    "next-with-less": "^3.0.1",
    "react": "^19.3.1",
    "react-bootstrap-editor": "^3.0.0-rc.0",
    "react-dom": "^19.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "undici": "^8.12.4",
    "web-utility": "^4.8.1",
    "webpack": "^5.112.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
    "@types/koa": "^3.0.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-idea2app-next-js": "^0.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-css-order": "^2.2.0",
    "serwist": "^9.5.13",
    "typescript": "~6.0.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-css-order",
      "@softonus/prettier-plugin-duplicate-remover"
    ]
  },
  "lint-staged": {
    "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write",
    "*.{css,js,mjs,ts,tsx}": "eslint --fix"
  },
  "scripts": {
    "prepare": "husky",
    "install": "next typegen --webpack",
    "dev": "next dev --webpack",
    "build": "cross-env CI=true  next build --webpack",
    "start": "next start",
    "lint-all": "eslint --fix .",
    "lint:inspect": "eslint --inspect-config",
    "test": "lint-staged  &&  tsc --noEmit",
    "pack-image": "docker build -t idea2app/next-bootstrap-ts:latest .",
    "container": "docker rm -f next-bootstrap-ts  &&  docker run --name next-bootstrap-ts -p 3000:3000 -d idea2app/next-bootstrap-ts:latest"
  }
}
